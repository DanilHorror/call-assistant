# Скопируйте этот файл в .env и впишите свои значения.
# .env не должен попадать в git / никому не показывайтесь его содержимое.

# --- API-ключи ---
DEEPGRAM_API_KEY=

# --- Аудио-устройства (индексы) ---
# Узнать индексы: python src/list_audio_devices.py
MIC_DEVICE_INDEX=
SYSTEM_AUDIO_DEVICE_INDEX=
# false = не захватывать микрофон вообще — свой голос не пишется и не
# попадает в транскрипт/подсказки, только собеседник из системного звука.
# MIC_DEVICE_INDEX в этом случае не нужен. По умолчанию true (как раньше).
MIC_CAPTURE_ENABLED=true

# --- STT ---
# auto  = пробуем локальный faster-whisper, при отставании переключаемся на Deepgram
# local = всегда faster-whisper
# cloud = всегда Deepgram
STT_MODE=auto

# Модель faster-whisper: tiny / base / small / medium / large-v3
# small или medium — разумный баланс скорости/качества на RTX-видеокарте.
# Если модель путает слова (например "Данил" слышит как "Нанил") — сначала
# попробуйте medium, она заметно точнее small на русском.
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Язык распознавания (ru/en/... или auto для автоопределения)
LANGUAGE=ru

# Необязательная подсказка словаря для распознавания — имена, термины,
# которые модель иначе может расслышать неверно. Не гарантия, но снижает
# число таких ошибок. Пример:
# WHISPER_INITIAL_PROMPT=Данил, Дота 2, умножитель, звонок, договорённость
WHISPER_INITIAL_PROMPT=

# --- Различение собеседников по голосу (для групповых звонков) ---
# true = помечать разных людей в "системном" звуке как "Собеседник 1", "Собеседник 2"...
# false = все, кроме вас, идут одной меткой "Собеседник" (быстрее запуск, меньше нагрузки)
DIARIZATION_ENABLED=true
# Порог схожести голосов (0..1), выше которого фраза считается тем же
# человеком. По умолчанию 0.72 — рассчитано на чистый голос в звонке.
# Если один и тот же человек постоянно получает разные номера "Собеседник N"
# (часто бывает на зашумлённом/продюсированном звуке — YouTube с музыкой,
# эффектами и т.п.) — понизьте, например до 0.55. Если наоборот разные люди
# схлопываются в одну метку — повысьте.
DIARIZATION_SIMILARITY_THRESHOLD=0.72

# --- Куда сохранять транскрипты и саммари ---
OUTPUT_DIR=./sessions

# --- Локальная модель для саммари и live-подсказок (через Ollama) ---
# Модель нужно один раз скачать: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# --- Live-подсказки поверх экрана во время звонка (Этап 2) ---
# true = полупрозрачное окно с подсказками, обновляется после каждой фразы собеседника
# false = только транскрипт + саммари в конце, без оверлея
LIVE_HINTS_ENABLED=true
# Сколько последних строк транскрипта отдавать модели как контекст для подсказки.
# Больше — лучше разрешаются местоимения/отсылки к более ранней теме разговора,
# но чуть длиннее и дороже запрос к модели.
HINTS_CONTEXT_LINES=20

# Контекстное окно Ollama в токенах, ТОЛЬКО для живых подсказок (на саммари
# после звонка не влияет — там нужен весь транскрипт целиком). Меньше окно —
# меньше видеопамяти под KV-кэш модели, а значит больше шансов, что модель
# целиком поместится на GPU вместо частичного ухода на CPU (см. `ollama ps` —
# столбец PROCESSOR должен быть 100% GPU; если там указан процент на CPU,
# попробуйте уменьшить это число, например до 1024, и снова проверить `ollama
# ps` после перезапуска модели). Подсказкам за глаза хватает 2048 — в промпт и
# так уходит только HINTS_CONTEXT_LINES строк транскрипта.
OLLAMA_NUM_CTX=2048

# Отдельное контекстное окно ТОЛЬКО для судьи-классификатора (judge.py) — не
# путайте с OLLAMA_NUM_CTX выше, хотя судья тоже всегда ходит в Ollama.
# Промт судьи (правила + 9 примеров) сам по себе занимает ~2000 расчётных
# токенов — даже после сжатия формулировок реальные звонки показывают
# переполнение при 2048 нестабильными симптомами (то один, то другой кейс
# проваливается между прогонами при неизменном промте — признак обрезки
# контекста, а не проблемы с качеством правил). 3072 — ПЕРВАЯ ПОПЫТКА, не
# проверенная на вашем железе: тот же 8ГБ GPU/gemma2:9b, что уже один раз не
# поместился целиком на num_ctx=4096 (см. комментарий выше) — не поместиться
# на 3072 тоже возможно. Проверяйте по `ollama ps` (столбец PROCESSOR) или по
# резкому росту задержки судьи — если модель ушла частично на CPU, пробуйте
# меньшее значение, например 2560.
JUDGE_NUM_CTX=3072

# --- ВРЕМЕННО: сольная тренировка без второго собеседника ---
# true = подсказки генерируются и на фразы из "Я" (ваш микрофон), не только
# на "Собеседник" (система/VB-Cable) — то есть можно просто спросить голосом
# самого себя и получить подсказку/ответ. По умолчанию false — поведение
# обычного звонка не меняется, пока не включите явно. Верните обратно в
# false, когда закончите тренировку.
HINTS_ON_MIC=false

# Писать ли каждый сгенерированный вопрос+ответ отдельным файлом сессии
# (sessions/<дата_время>/questions_and_answers.md, см. hint_log.py). В
# transcript.txt хранится только то, что произнесено вслух — самих ответов
# модели там нет, а в оверлее ответ виден только пока идёт звонок и
# теряется после закрытия. По умолчанию включено — это просто дополнительный
# файл, поведение самих подсказок никак не меняет.
HINTS_LOG_ENABLED=true

# Свободный текст про сам разговор, который не меняется от
# вопроса к вопросу — подставляется в промпт live-подсказок перед историей
# разговора (см. _build_user_message в live_hints.py). Полезно, например,
# чтобы модель не путала язык программирования: без этого GigaChat на вопрос
# "напиши функцию проверки палиндрома" один раз ответила кодом на C/C++
# вместо ожидаемого Python — ей просто неоткуда было знать, какой язык
# имеется в виду. Пишите здесь то, что верно для ВСЕГО разговора (язык,
# стек, позицию, компанию и т.п.), а не для одного конкретного вопроса.
# По умолчанию пусто — поведение не меняется. Пример:
# HINTS_EXTRA_CONTEXT=Звонок в поддержку интернет-провайдера «СетьПлюс». Отвечай от лица оператора.
HINTS_EXTRA_CONTEXT=

# --- Локальная база знаний для live-подсказок (необязательно) ---
# Заранее подготовленный набор пар вопрос/ответ (например, справочник
# по продукту в формате JSON — [{"question": "...", "answer": "...",
# "section": "..."}, ...]). Если включено — перед каждым запросом к модели
# ищутся записи, похожие по словам на текущую фразу собеседника, и, если
# что-то нашлось, подставляются в промпт как проверенный источник факта.
# По умолчанию выключено, чтобы поведение не менялось без явного включения.
KB_ENABLED=false
# Путь к JSON-файлу базы знаний, относительно корня проекта (или абсолютный).
KB_PATH=./data/knowledge_base.json
# Сколько записей максимум подставлять в промпт за раз.
KB_TOP_K=3
# Порог совпадения (0..~1.3) — ниже него запись считается нерелевантной и
# отбрасывается. Если база знаний подставляет мусор не по теме — повысьте
# (например до 0.2-0.3). Если наоборот пропускает явные совпадения — понизьте.
KB_MIN_SCORE=0.15

# --- Облачная модель GigaChat (Сбер) (Этап 3) ---
# Изначально задумывалось только для "сложных" вопросов (алгоритмические
# задачи по программированию, ситуационные вопросы), но по итогам массовых
# сравнительных прогонов (см. src/batch_test*.py --backend gigachat)
# GigaChat оказалась быстрее и не хуже локальной Ollama и на ОБЫЧНЫХ
# вопросах — поэтому теперь, если включено, GigaChat отвечает на ВСЕ
# вопросы, просто разными своими моделями (см. GIGACHAT_MODEL и
# GIGACHAT_NORMAL_MODEL ниже). Round 11 (см. ниже и проектный документ):
# Ollama как автоматический запасной вариант при сбое GigaChat полностью
# УБРАНА — при сбое пользователь вместо этого получает уведомление в
# интерфейсе (см. GIGACHAT_MODEL_CASCADE и раздел "Round 11" ниже). GigaChat
# работает из России без VPN, оплата (если понадобится) — рублями напрямую,
# у физлиц есть бесплатный лимит токенов.
# По умолчанию выключено — поведение не меняется, пока не включите явно.
GIGACHAT_ENABLED=false

# "Authorization key" — получаете один раз в личном кабинете
# developers.sber.ru: GigaChat API -> ваш проект (тип "физическое лицо") ->
# "Авторизационные данные" -> Сгенерировать ключ. Строка в base64, показывается
# только один раз при создании — сохраните сразу. Никому не показывайте и не
# коммитьте в git (как и остальной .env).
GIGACHAT_CREDENTIALS=

# Модель для "сложных" вопросов (см. main.py _looks_like_hard_question) —
# алгоритмические задачи по программированию и решаемые ситуационные
# вопросы, где локальной модели на 8ГБ видеокарте не хватает качества
# рассуждения. Тут оправдана более сильная (и дорогая) модель — таких
# вопросов в звонке немного, а качество ответа важнее экономии.
GIGACHAT_MODEL=GigaChat-3-Ultra

# Модель для ВСЕХ ОСТАЛЬНЫХ (обычных) вопросов — тут наоборот важна скорость
# и бесплатный лимит токенов с запасом, раз вопросов много: в тестах
# GigaChat-2 отвечала быстрее Ultra (~1-1.5с против ~2-3с) и не хуже по
# существу на реальных вопросах из data/knowledge_base.json. Не путайте с
# GIGACHAT_MODEL выше — это разные переменные для разных категорий вопросов.
GIGACHAT_NORMAL_MODEL=GigaChat-2

# Список моделей, реально доступных именно вашему аккаунту/тарифу, можно
# посмотреть скриптом src/check_gigachat_status.py.

# Без этого запросы к GigaChat падают с ошибкой
# "SSL: CERTIFICATE_VERIFY_FAILED: self-signed certificate in certificate chain" —
# GigaChat подписан сертификатом российского удостоверяющего центра
# (Минцифры), которого нет в стандартном списке доверенных корневых
# сертификатов. Один раз скачайте официальный файл сертификата (можно прямо
# из командной строки Windows, curl.exe идёт в комплекте с Windows 10/11):
#   curl -k https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt -o russian_trusted_root_ca.pem
# Сохраните его в корень проекта (рядом с .env) и впишите путь сюда:
GIGACHAT_CA_BUNDLE_FILE=./russian_trusted_root_ca.pem

# Round 10M — семантический recall старых ответов по смыслу вопроса, а не
# только по буквальным словам "повтори"/"тот же" (round 10L). ПО УМОЛЧАНИЮ
# ВЫКЛЮЧЕНО намеренно: похожесть уже считается и логируется в logs\latest.log
# ("[recall] похожесть...") даже при false — это позволяет сначала посмотреть
# реальные цифры с живых звонков, прежде чем разрешать этому влиять на
# подсказки. Включите (true), когда по логам увидите, что цифры разумно
# разделяют "да, это отсылка к старому ответу" от "нет, обычный вопрос".
# Откат — просто верните обратно false, код трогать не нужно.
SEMANTIC_RECALL_ENABLED=false

# Порог косинусной похожести (0..1) для включённого SEMANTIC_RECALL_ENABLED
# выше. 0.72 — первая, не откалиброванная на реальных данных попытка (как в
# своё время JUDGE_NUM_CTX) — подберите точнее по реальным цифрам из логов.
SEMANTIC_RECALL_THRESHOLD=0.72

# Round 10N — по умолчанию true: если GigaChat решил, что текущий вопрос
# продолжает уже известную тему (не новую), ассистент ВСЕГДА подтягивает
# реальный текст старого обмена репликами по этой теме (не только её
# название) — вне зависимости от того, что именно просят сделать с этим
# содержимым (повторить/доработать/сравнить и т.п. решает сама модель).
# Замена узкой логике SEMANTIC_RECALL_* выше. Поставьте false, чтобы
# вернуться к старому, более узкому поведению (срабатывает только на явную
# просьбу "повтори" или высокую семантическую похожесть).
#
# Round 11: система тегов (эта настройка и SEMANTIC_RECALL_* выше) заменена
# на эмбеддинг-поиск по всему пулу реплик (см. POOL_SIMILARITY_THRESHOLD
# ниже) — сама логика тегов НЕ удалена, доступна как откат, но по умолчанию
# больше не вызывается. Эта настройка сохранена в коде без изменений на
# случай отката.
ALWAYS_RETRIEVE_ON_CONTINUATION=true

# --- Round 11 (см. проектный документ) ---------------------------------

# Каскад моделей GigaChat, от сильной к слабой — main.py начинает с той
# модели, что и так выбрал бы (GIGACHAT_MODEL для сложных вопросов,
# GIGACHAT_NORMAL_MODEL для обычных), и при исчерпании токенов (HTTP 402)
# у ТЕКУЩЕЙ модели автоматически переходит на следующую в этом списке,
# начиная с её позиции. Порядок и точные строки моделей — по названиям
# тарифов Сбера, но НЕ проверены на реальном API (сверьтесь с
# src/check_gigachat_status.py, если каскад вернёт ошибку 400/404 —
# значит имя модели в списке не совпадает с тем, что реально доступно
# вашему аккаунту, поправьте здесь).
GIGACHAT_MODEL_CASCADE=GigaChat-3-Ultra,GigaChat-2-Max,GigaChat-2-Pro,GigaChat-2

# Ollama как фолбэк для генерации ответа полностью отключена (см. main.py,
# round 11) — при любом сбое GigaChat (сеть/ключ/токены/что угодно ещё)
# пользователь получает уведомление в интерфейсе (overlay.py), без попытки
# сгенерировать ответ локальной моделью. Отдельной настройки на это нет —
# это теперь единственное поведение при GIGACHAT_ENABLED=true.

# Порог косинусного сходства (0..1) для эмбеддинг-поиска по пулу реплик
# (main.py/reply_pool.py) — заменяет всю систему тегов (round 9-10O). ПЕРВАЯ
# ПОПЫТКА, не откалибровано на реальных данных именно для новой
# эмбеддинг-модели deepvk/USER-bge-m3 (см. EMBEDDING ниже) — старое число
# SEMANTIC_RECALL_THRESHOLD=0.72 сюда НЕ переносится, у BGE-семейства
# моделей обычно другое распределение похожести. Похожесть для топ-N
# кандидатов логируется ВСЕГДА в logs\latest.log, независимо от порога —
# подберите число по реальным цифрам (в том числе прогоном существующих
# файлов data/stress_test_300*.json / data/stress_test_v2*.json синтетически).
POOL_SIMILARITY_THRESHOLD=0.75
